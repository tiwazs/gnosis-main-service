DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<dbname>"

SERVER=<server-host>
PORT=4000
PORT_SWAGGER=443
SWAGGER_HTTPS=true
LOGGER_LEVEL=<info/debug>
NODE_ENV=<development/production>
ENV=<develop/production>
TOKEN_KEY=<token-key>
GATEWAY_INTERNAL_SECRET=<shared-secret-with-gateway-and-nextauth>

SSL_KEY=./certificates/<key.pem>
SSL_CERT=./certificates/<cert.pem>

FACE_ANALYTICS_SERVER=<recognizer-service-host>
FACE_ANALYTICS_PORT=<recognizer-service-port>
RESOURCES_PATH=<absolute/path/to/resources/>

SFTP_HOST=<sftp-host>
SFTP_PORT=2222
SFTP_USER=<sftp-user>
SFTP_PASSWORD=<sftp-password>

# K8S env vars
# to set env to k8s yaml
# $ set -o allexport
# $ source .env
# $ set +o allexport
# $ envsubst < deployment/k8s.yaml > deployment/k8s_patched.yaml

IMAGE_NAME=<image-name>
IMAGE_TAG=<image-tag>
DOMAIN=<domain>
CORS_ALLOW_ORIGIN=<cors-origins>
CLUSTER_ISSUER=<cert-manager-cluster-issuer>

K8S_MIN_REPLICAS=1
K8S_NAMESPACE=<deployment-namespace>
K8S_RESOURCES_LIMITS_CPU=1000m
K8S_RESOURCES_LIMITS_MEMORY=1000Mi
K8S_RESOURCES_REQUESTS_CPU=20m
K8S_RESOURCES_REQUESTS_MEMORY=30Mi
K8S_SERVICE_NAME=gnosis-main
